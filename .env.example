# Four digits each. Never commit real PINs or production secrets.
CAFE_CASHIER_PIN=1234
CAFE_ADMIN_PIN=5678

# At least 32 random characters. Generate a different secret per environment.
CAFE_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Server-only values. Do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# QZ Tray: certificate is public; the private PKCS#8 key remains server-only.
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=
